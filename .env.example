# ==============================================================================
# TripWeaver AI — Environment Configuration Template
# Copy this file to .env and insert your API keys and database credentials
# ==============================================================================

# ── Core Database & LLM ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripweaver?sslmode=require
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── External MCP Tool Providers ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-your_tavily_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
OPENWEATHER_API_KEY=your_openweather_key_here
DEFAULT_ORIGIN_IATA=IND

# ── Enterprise Settings (Optional) ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=60
LANGSMITH_TRACING=false
